{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Project",
  "description": "Version-one and version-two snapshots remain readable with their historical phase orders. Version-three projects use the voice-timed phase order; recovery projections never rewrite event history.",
  "oneOf": [
    {
      "description": "Legacy version-one snapshot; retained only for immutable historical project recovery.",
      "type": "object",
      "required": ["schema_version", "project_id", "workflow", "phase"],
      "properties": {
        "schema_version": {"const": 1},
        "project_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "active_timeline_id": {"type": "string", "minLength": 1},
        "phase": {
          "enum": [
            "initialized",
            "content_ready",
            "direction_ready",
            "storyboard_ready",
            "production_ready",
            "assembled",
            "review_ready",
            "handoff_ready"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Current version-two snapshot. New phase events must pass through voice_ready; compatibility recovery is a read-only view for pre-voice event logs.",
      "type": "object",
      "required": ["schema_version", "project_id", "workflow", "phase"],
      "properties": {
        "schema_version": {"const": 2},
        "project_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "active_timeline_id": {"type": "string", "minLength": 1},
        "phase": {
          "enum": [
            "initialized",
            "content_ready",
            "direction_ready",
            "voice_ready",
            "storyboard_ready",
            "production_ready",
            "assembled",
            "review_ready",
            "handoff_ready"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Current version-three voice-timed workflow snapshot.",
      "type": "object",
      "required": ["schema_version", "project_id", "workflow", "phase"],
      "properties": {
        "schema_version": {"const": 3},
        "project_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "active_timeline_id": {"type": "string", "minLength": 1},
        "phase": {
          "enum": [
            "script_confirmed",
            "semantic_beats_confirmed",
            "visual_direction_previewed",
            "voiceover_ready",
            "timing_bound",
            "storyboard_timed",
            "representative_scene_ready",
            "production_ready"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
