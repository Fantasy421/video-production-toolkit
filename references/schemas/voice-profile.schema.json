{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Approved TTS Voice Profile Artifact",
  "type": "object",
  "required": [
    "artifact_id", "type", "version", "status", "parents", "path",
    "narration_id", "source_decision_id", "mode", "language", "provider",
    "voice_id", "speaking_rate", "emotion", "pronunciations", "approved",
    "consent_provenance", "profile_provenance"
  ],
  "properties": {
    "artifact_id": {"$ref": "#/$defs/safeId"},
    "type": {"const": "voice-profile"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved", "stale", "superseded", "invalid"]},
    "parents": {"$ref": "#/$defs/parents"},
    "path": {"$ref": "#/$defs/projectPath"},
    "output_contract": {"type": "string", "minLength": 1, "maxLength": 128},
    "narration_id": {"$ref": "#/$defs/safeId"},
    "source_decision_id": {"$ref": "#/$defs/safeId"},
    "mode": {"const": "tts"},
    "language": {"$ref": "#/$defs/token64"},
    "provider": {"$ref": "#/$defs/text128"},
    "voice_id": {"$ref": "#/$defs/safeId"},
    "speaking_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
    "emotion": {"$ref": "#/$defs/text128"},
    "pronunciations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nonEmptyText"}, "uniqueItems": true},
    "approved": {"const": true},
    "consent_provenance": {"$ref": "#/$defs/nonEmptyText"},
    "profile_provenance": {"$ref": "#/$defs/nonEmptyText"}
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"},
    "parents": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true},
    "projectPath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\]+$"},
    "nonEmptyText": {"type": "string", "minLength": 1, "maxLength": 500},
    "text128": {"type": "string", "minLength": 1, "maxLength": 128},
    "token64": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
