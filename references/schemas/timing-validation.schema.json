{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Compact Timing Validation",
  "$comment": "The runtime validator is normative for cross-field equality between issue_counts and examples; Draft 2020-12 expresses the bounded compact shape only.",
  "type": "object",
  "required": ["status", "checks_run"],
  "properties": {
    "status": {"enum": ["blocked", "passed"]},
    "checks_run": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "issue_counts": {"$ref": "#/$defs/issueCounts"},
    "examples": {"$ref": "#/$defs/examples"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {"required": ["issue_counts", "examples"]}
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {"not": {"anyOf": [{"required": ["issue_counts"]}, {"required": ["examples"]}]}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "safeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"},
    "issueCode": {"enum": ["VOICE_TIMING_REQUIRED", "KEYWORD_ANCHOR_MISSING", "VISUAL_BEFORE_ALLOWED_WINDOW", "VISUAL_AFTER_ALLOWED_WINDOW", "BEAT_OUTSIDE_SCENE", "MULTIPLE_PRIMARY_CARRIERS", "SUPPORT_LAYER_OVERFLOW", "KEYWORD_EVENTS_TOO_CLOSE", "SCENE_TOO_SHORT", "STALE_VOICE_TIMING"]},
    "issueCounts": {"type": "object", "propertyNames": {"$ref": "#/$defs/issueCode"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 1000000}, "minProperties": 1},
    "examples": {"type": "object", "propertyNames": {"$ref": "#/$defs/issueCode"}, "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true, "maxItems": 3}, "minProperties": 1}
  }
}
