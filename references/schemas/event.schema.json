{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Event",
  "description": "Version-one pre-voice logs remain readable through a non-mutating recovery compatibility projection. Newly initialized version-two projects use the voice_ready order; phase-event legality is evaluated against the initialization event during replay.",
  "oneOf": [
    {
      "type": "object",
      "description": "Legacy version-one initialization retained for immutable event-log replay.",
      "required": ["event", "schema_version", "project_id", "workflow"],
      "properties": {
        "event": {"const": "project.initialized"},
        "schema_version": {"const": 1},
        "project_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    {
      "description": "Current version-two initialization for newly created projects.",
      "type": "object",
      "required": ["event", "schema_version", "project_id", "workflow"],
      "properties": {
        "event": {"const": "project.initialized"},
        "schema_version": {"const": 2},
        "project_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["event", "phase"],
      "properties": {
        "event": {"const": "project.phase_changed"},
        "phase": {
          "enum": [
            "content_ready", "direction_ready", "voice_ready", "storyboard_ready",
            "production_ready", "assembled", "review_ready", "handoff_ready"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["event", "active_timeline_id"],
      "properties": {
        "event": {"const": "project.active_timeline_changed"},
        "active_timeline_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["event", "changed_id", "artifact_ids"],
      "properties": {
        "event": {"const": "artifacts.invalidated"},
        "changed_id": {"type": "string", "minLength": 1},
        "artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  ]
}
