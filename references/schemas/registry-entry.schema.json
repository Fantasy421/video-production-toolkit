{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Registry Entry",
  "type": "object",
  "required": ["id", "version", "job", "preview", "renderer", "implementation_ref", "license"],
  "properties": {
    "id": {"$ref": "#/$defs/nonEmptyString"},
    "version": {"$ref": "#/$defs/nonEmptyString"},
    "job": {"$ref": "#/$defs/nonEmptyString"},
    "preview": {"$ref": "#/$defs/nonEmptyString"},
    "renderer": {"$ref": "#/$defs/nonEmptyString"},
    "implementation_ref": {"$ref": "#/$defs/nonEmptyString"},
    "license": {"$ref": "#/$defs/nonEmptyString"},
    "mechanism": {"$ref": "#/$defs/nonEmptyString"},
    "participants": {"$ref": "#/$defs/stringArray"},
    "duration": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "number", "minimum": 0},
            "max": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "canvas": {"$ref": "#/$defs/stringArray"},
    "carriers": {"$ref": "#/$defs/stringArray"},
    "capabilities": {"$ref": "#/$defs/stringArray"},
    "accepts": {"$ref": "#/$defs/stringArray"},
    "outputs": {"$ref": "#/$defs/stringArray"},
    "editable": {"type": "boolean"},
    "installed_skill": {"$ref": "#/$defs/nonEmptyString"},
    "capability_skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}
    },
    "capability_implementation_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 10,
        "pattern": "^external:.+"
      }
    },
    "fallback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
    "license_mode": {"const": "external-reference"},
    "tokens": {"type": "object", "minProperties": 1},
    "rules": {"$ref": "#/$defs/stringArray"},
    "previews": {"$ref": "#/$defs/stringArray"},
    "applicability": {"$ref": "#/$defs/stringArray"},
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "required_fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["family", "source"],
            "properties": {
              "family": {"$ref": "#/$defs/nonEmptyString"},
              "source": {"const": "system"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["family", "source", "path"],
            "properties": {
              "family": {"$ref": "#/$defs/nonEmptyString"},
              "source": {"const": "bundled"},
              "path": {"$ref": "#/$defs/nonEmptyString"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["canvases", "renderers"],
      "properties": {
        "canvases": {"$ref": "#/$defs/stringArray"},
        "renderers": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "project_evidence": {"$ref": "#/$defs/stringArray"},
    "regions": {
      "type": "object",
      "required": ["subject", "information", "subtitle", "platform_safe"],
      "properties": {
        "subject": {"$ref": "#/$defs/region"},
        "information": {"$ref": "#/$defs/region"},
        "subtitle": {"$ref": "#/$defs/region"},
        "platform_safe": {"$ref": "#/$defs/region"}
      },
      "additionalProperties": false
    },
    "density": {"enum": ["low", "medium", "high"]},
    "media_compatibility": {"$ref": "#/$defs/stringArray"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
