{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Real Voice Timing",
  "type": "object",
  "required": ["artifact_id", "voiceover_id", "timing_kind", "duration_ms", "segments", "parents"],
  "properties": {
    "artifact_id": {"$ref": "#/$defs/safeId"},
    "voiceover_id": {"$ref": "#/$defs/safeId"},
    "timing_kind": {"const": "real"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "parents": {"type": "array", "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_:-]*)*$"},
    "segment": {
      "type": "object",
      "required": ["start_ms", "end_ms", "text"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
