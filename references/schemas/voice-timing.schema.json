{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Real Voice Timing Artifact",
  "type": "object",
  "required": ["artifact_id", "type", "version", "status", "parents", "path", "voiceover_id", "timing_kind", "duration_ms", "segments"],
  "properties": {
    "artifact_id": {"$ref": "#/$defs/safeId"}, "type": {"const": "voice-timing"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["draft", "approved", "stale", "superseded", "invalid"]}, "parents": {"$ref": "#/$defs/parents"}, "path": {"$ref": "#/$defs/projectPath"}, "output_contract": {"type": "string", "minLength": 1, "maxLength": 128},
    "voiceover_id": {"$ref": "#/$defs/safeId"}, "timing_kind": {"const": "real"}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 36000000}, "segments": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/segment"}}, "keyword_anchors": {"type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/anchor"}}
  },
  "additionalProperties": false,
  "$defs": {"safeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"}, "parents": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true}, "projectPath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\]+$"}, "segment": {"type": "object", "required": ["start_ms", "end_ms", "text"], "properties": {"start_ms": {"type": "integer", "minimum": 0, "maximum": 35999999}, "end_ms": {"type": "integer", "minimum": 1, "maximum": 36000000}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}}, "additionalProperties": false}, "anchor": {"type": "object", "required": ["beat_id", "keyword", "start_ms", "end_ms"], "properties": {"beat_id": {"$ref": "#/$defs/safeId"}, "keyword": {"type": "string", "minLength": 1, "maxLength": 256}, "start_ms": {"type": "integer", "minimum": 0, "maximum": 35999999}, "end_ms": {"type": "integer", "minimum": 1, "maximum": 36000000}}, "additionalProperties": false}}
}
