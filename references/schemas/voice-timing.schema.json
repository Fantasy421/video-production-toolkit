{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Toolkit Real Voice Timing Artifact",
  "type": "object",
  "required": ["artifact_id", "type", "version", "status", "parents", "path", "voiceover_id", "timing_kind", "duration_ms", "segments"],
  "properties": {
    "artifact_id": {"$ref": "#/$defs/safeId"}, "type": {"const": "voice-timing"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["draft", "approved", "stale", "superseded", "invalid"]}, "parents": {"$ref": "#/$defs/parents"}, "path": {"$ref": "#/$defs/projectPath"}, "output_contract": {"type": "string", "minLength": 1},
    "voiceover_id": {"$ref": "#/$defs/safeId"}, "timing_kind": {"const": "real"}, "duration_ms": {"type": "integer", "minimum": 1}, "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
  },
  "additionalProperties": false,
  "$defs": {"safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"}, "parents": {"type": "array", "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true}, "projectPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\]+$"}, "segment": {"type": "object", "required": ["start_ms", "end_ms", "text"], "properties": {"start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
}
